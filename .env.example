# Enterprise ITSM Environment Variables Configuration

# Application Configuration
APP_NAME="Enterprise ITSM"
APP_ENV="development"
PORT=3000
FRONTEND_URL="http://localhost:3000"
DEMO_MODE="true"

# Database Configuration (MySQL 8.0 for Profile B / Vercel Serverless DB for Profile A)
DATABASE_URL="mysql+pymysql://itsm_user:itsm_secure_pass@localhost:3306/enterprise_itsm"
# For SQLite fallback during local zero-dependency testing:
# DATABASE_URL="sqlite+aiosqlite:///./enterprise_itsm.db"

# Authentication & Security
JWT_SECRET="replace-with-a-very-long-and-cryptographically-secure-random-string-in-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default Administrator Bootstrapping
ADMIN_INITIAL_EMAIL="admin@enterprise-itsm.local"
ADMIN_INITIAL_PASSWORD="ChangeMeInProduction!2026"

# SLA & Business Calendar Defaults
DEFAULT_TIMEZONE="UTC"
BUSINESS_HOURS_START="09:00"
BUSINESS_HOURS_END="18:00"
BUSINESS_DAYS="Monday,Tuesday,Wednesday,Thursday,Friday"

# Storage & Uploads
UPLOAD_MAX_SIZE_MB=25
ALLOWED_UPLOAD_EXTENSIONS="pdf,png,jpg,jpeg,txt,log,csv,docx,xlsx"

